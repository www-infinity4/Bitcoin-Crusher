{
  "schema": "infinity/avatar-coin-site/v2",
  "siteId": "bitcoin-crusher",
  "siteName": "Bitcoin Crusher",
  "marker": {
    "symbol": "₿",
    "label": "Bitcoin Avatar Coin",
    "coverage": "intentional edit anchors only",
    "maxAutomaticMarkers": 8
  },
  "portal": {
    "module": "assets/avatar-wave.js",
    "recordSchema": "infinity/avatar-coin-creation/v2",
    "localDraftCache": true,
    "canonicalLedger": "www-infinity4/INFINITY/avatar-coin",
    "sharedPublishing": true
  },
  "automaticAnchors": [
    ".topbar-name",
    ".hero-title",
    ".machine-title-text",
    ".panel-title",
    "[data-avatar-anchor]"
  ],
  "excludedByDefault": [
    "p",
    "label",
    "footer",
    ".result-text",
    ".chat-bubble",
    ".ham-link",
    ".ham-section-label"
  ],
  "allocation": {
    "creatorWalletDailyMax": 10,
    "overflow": "PROJECT_MATCH_POOL",
    "creatorAttributionPersists": true,
    "purchaseChangesHolderNotCreator": true
  },
  "principle": "The Avatar marker is a deliberate portal into a creation chain, not decoration beside every editable sentence."
}